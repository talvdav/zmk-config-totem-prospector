#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define SpaceNav    2
#define Num         3
#define Sym         4
#define Func        5
#define MouseNav    6
#define Game        7
#define GamePlus    8

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <100>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = ". :";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = ", :";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            timeout-ms = <50>;
            require-prior-idle-ms = <500>;
            key-positions = <0 9>;
            layers = <Func>;
            bindings = <&bootloader>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <13 16>;
            bindings = <&caps_word>;
        };

        combo_game {
            timeout-ms = <50>;
            require-prior-idle-ms = <500>;
            key-positions = <32 37>;
            bindings = <&tog Game>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
            &kp Q  &kp W  &kp E &kp R &kp T &kp Y &kp U   &kp I &kp O &kp P
            &kp A  &kp S  &kp D &kp F &kp G &kp H &kp J   &kp K &kp L &comma_semi
&kp LSHIFT  &kp Z  &kp X  &kp C &kp V &kp B &kp N &kp M   &dot_colon &comma_semi &kp SLASH &kp RSHIFT
            &lt SpaceNav ESCAPE  &lt Nav SPACE  &lt MouseNav TAB &lt Sym ENTER  &lt Num BSPC  &lt Func DELETE
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
       &trans  &trans  &trans  &trans  &trans    &none     &kp PAGE_DOWN  &kp UP    &kp PG_UP  &none
       &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp LEFT       &kp DOWN  &kp RIGHT  &kp END
&none  &trans  &trans  &trans  &trans  &trans    &none     &none          &none     &none      &none    &none
                       &trans  &trans  &trans    &trans    &trans         &trans
            >;
        };

        SpaceNav {
            display-name = "Spaces";
            bindings = <
       &none           &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &none        &none   &none               &kp LA(UP_ARROW)    &none                &none
       &kp LEFT_SHIFT  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)  &kp LA(NUMBER_6)  &kp LA(F)    &none   &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(RIGHT_ARROW)  &none
&none  &none           &kp LA(N7)        &kp LA(N8)        &kp LA(N9)        &kp LA(V)    &none   &none               &none               &none                &none  &none
                                         &trans            &trans            &trans       &trans  &trans              &trans
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
       &kp PIPE      &kp N1  &kp N2     &kp N3  &kp STAR        &trans  &trans  &trans  &trans  &trans
       &kp FSLH      &kp N4  &kp N5     &kp N6  &kp EQUAL       &trans  &trans  &trans  &trans  &trans
&none  &kp BSLH      &kp N7  &kp N8     &kp N9  &kp MINUS       &trans  &trans  &trans  &trans  &trans  &trans
                             &kp COMMA  &kp N0  &kp DOT         &trans  &trans  &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
       &kp PRCNT      &kp AT         &kp TILDE      &kp LBRC       &kp RBRC        &trans  &trans  &trans  &trans  &trans
       &kp POUND      &kp CARET      &kp DLLR       &kp LPAR       &kp RPAR        &trans  &trans  &trans  &trans  &trans
&none  &kp QMARK      &kp EXCL       &kp GRAVE      &kp LBKT       &kp RBKT        &trans  &trans  &trans  &trans  &trans  &trans
                                     &kp LT         &kp UNDER      &kp GT          &trans  &trans  &trans
            >;
        };

        Func {
            display-name = "Func";
            bindings = <
                &kp F10  &kp F1  &kp F2  &kp F3  &none     &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &trans
                &kp F11  &kp F4  &kp F5  &kp F6  &none     &trans  &trans             &trans           &trans      &trans
&studio_unlock  &kp F12  &kp F7  &kp F8  &kp F9  &none     &trans  &trans             &trans           &trans      &trans  &trans
                                 &trans  &trans  &trans    &trans  &trans             &trans
            >;
        };

        MouseNav {
            display-name = "Mouse";
            bindings = <
        &none           &none      &none      &none      &none        &trans          &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_UP     &trans
        &kp LEFT_SHIFT  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Z)    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT
&trans  &none           &none      &none      &none      &none        &trans          &trans          &trans          &trans           &trans           &trans
                                   &trans     &trans     &trans       &mkp RCLK       &mkp LCLK       &mkp MCLK
            >;
        };

        Game {
            display-name = "Game";
            bindings = <
       &kp TAB         &kp Q  &kp W      &kp E      &kp R              &none  &none  &none  &none  &none
       &kp LSHIFT      &kp A  &kp S      &kp D      &kp F              &none  &none  &none  &none  &none
&none  &kp LCTRL       &kp Z  &kp X      &kp C      &kp V              &none  &none  &none  &none  &none  &none
                              &kp ESC    &kp SPACE  &sl GamePlus       &none  &none  &none
            >;
        };

        GamePlus {
            display-name = "Game+";
            bindings = <
       &kp I  &kp N1  &kp N2     &kp N3  &kp T        &none   &none  &none  &none  &none
       &kp K  &kp N4  &kp N5     &kp N6  &kp B        &none   &none  &none  &none  &none
&none  &kp M  &kp N7  &kp N8     &kp N9  &kp J        &none   &none  &none  &none  &none  &none
                      &trans     &kp N0  &trans       &none   &none  &none
            >;
        };
    };
};
